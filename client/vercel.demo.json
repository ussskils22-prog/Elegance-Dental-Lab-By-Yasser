{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://elegance-demo-api.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
