{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client/browser",
  "headers": [
    {
      "source": "/(ngsw.json|ngsw-worker.js|safety-worker.js|manifest.webmanifest|index.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://elegance-demo-api-ussskils22-progs-projects.vercel.app/api/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
